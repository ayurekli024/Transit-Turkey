<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IstanbulFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/istanbulwallpaper"
        android:scaleType="centerCrop" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KarTransit-Istanbul"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="70dp"
                android:shadowColor="@android:color/black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <EditText
                android:id="@+id/editText_stopSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Durak Adını veya Durak Numarasını Girin"
                android:padding="12dp"
                android:inputType="text"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/button_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arayın..."
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/buttonCardOperations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="İSTANBULKART İŞLEMLERİ"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00BCD4" />

            <Button
                android:id="@+id/buttonMetroMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="İSTANBUL RAYLI VE KABLOLU SİSTEM HARİTASI"
                android:layout_marginTop="16dp"
                android:backgroundTint="#4CAF50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="İSTANBUL'DAKİ BELLİ BAŞLI YERLER'"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:paddingBottom="10dp"
                android:textColor="@android:color/white"
                android:shadowColor="@android:color/black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />


            <LinearLayout
                android:id="@+id/places_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#99FFFFFF" /> <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>