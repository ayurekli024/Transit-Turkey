<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".IzmirCardActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İzmirimkart İşlemleri"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/buttonCheckBalanceizmir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bakiye Sorgula ve Yükle(Oturum Açmanız gerekebilir)"
        android:layout_marginBottom="20dp"
        android:padding="15dp"
        android:textSize="18sp" />

    <Button
        android:id="@+id/buttonTopUpizmir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESHOT Gittiğin kadar öde Tarife Sorgula"
        android:padding="15dp"
        android:textSize="18sp"
        android:backgroundTint="#FF9800" />
    <Button
        android:id="@+id/buttonCheckizban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İZBAN ücret tarifesi sorgula"
        android:layout_marginBottom="20dp"
        android:padding="15dp"
        android:textSize="18sp" />

</LinearLayout>